#!/bin/sh
set -e

MAVEN_VERSION=3.9.9
MAVEN_DIST_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
MVN_CMD="$MAVEN_DIST_DIR/bin/mvn"

if [ ! -f "$MVN_CMD" ]; then
    echo "Baixando Maven $MAVEN_VERSION..."
    MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz"
    mkdir -p "$HOME/.m2/wrapper/dists"
    curl -sL "$MAVEN_URL" | tar xz -C "$HOME/.m2/wrapper/dists/"
    echo "Maven $MAVEN_VERSION instalado em $MAVEN_DIST_DIR"
fi

exec "$MVN_CMD" "$@"
